/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The Pages project is also reachable on *.pages.dev (production and every
# branch preview). Keep those copies out of search results; only the custom
# domain is canonical.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

/:locale/medicine/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

/sitemap.xml
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/sitemaps/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/robots.txt
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/data/*
  Cache-Control: public, max-age=0, s-maxage=604800, stale-while-revalidate=86400
  X-Robots-Tag: noindex
